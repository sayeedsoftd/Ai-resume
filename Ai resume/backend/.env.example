# Project Settings
PROJECT_NAME="AI Resume Analyzer & Job Match System"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
SECRET_KEY="supersecretjwtkeyforairesumeanalyzersystemchangeinproduction"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Configuration
MYSQL_SERVER="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DB="ai_resume_db"

# Optional explicit DATABASE_URL (if omitted, constructed from MySQL settings above)
DATABASE_URL="mysql+pymysql://root:your_mysql_password@localhost:3306/ai_resume_db?charset=utf8mb4"

# Storage / Upload Directories
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
